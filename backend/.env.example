# ===================================================
# RepairHub Backend Environment Variables
# Copy to .env for local development or configure in Render Dashboard
# ===================================================

# Server Configuration
# (On Render, PORT is automatically injected by the platform)
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) for CORS
# In production on Render, set this to your Vercel deployment URL(s)
# Can be a single URL or comma-separated list of URLs
# Example: https://repairhub.vercel.app
CLIENT_URL=https://your-repairhub-app.vercel.app

# PostgreSQL Database Configuration
# Provide full connection string (e.g. from Render PostgreSQL, Supabase, Neon)
DATABASE_URL=postgresql://username:password@hostname:5432/repairhub_db

# Or individual PostgreSQL parameters (used if DATABASE_URL is not set):
PGHOST=localhost
PGPORT=5432
PGDATABASE=repairhub_db
PGUSER=postgres
PGPASSWORD=postgres

# Authentication Secret
# CRITICAL: Use a strong, random 32+ character secret in production!
JWT_SECRET=repairhub_super_secret_jwt_key_min_32_characters_replace_in_prod

# AI Assistant Diagnostic Engine (Optional)
# Leave empty to use the built-in comprehensive diagnostic rules engine
# Or provide a Google Gemini API key for live LLM responses
GEMINI_API_KEY=

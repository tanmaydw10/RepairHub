# ==============================================================================
# RepairHub Deployment & Environment Configuration Template
# ==============================================================================
# This template outlines all environment variables needed across services.
# Never commit actual .env files containing real secrets to GitHub!

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ------------------------------------------------------------------------------
# Set in Vercel Dashboard under Settings -> Environment Variables
# The URL where your Render backend API is hosted (without trailing slash)
VITE_API_URL=https://your-backend-api-name.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Web Service Settings)
# ------------------------------------------------------------------------------
# Set in Render Dashboard under Web Service -> Environment
NODE_ENV=production
PORT=5000

# Allowed client URL(s) for CORS. Can be comma-separated if multiple.
# Set this to your live Vercel domain:
CLIENT_URL=https://your-frontend-app.vercel.app

# PostgreSQL connection string (Provided by Render PostgreSQL or external DB)
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL=postgresql://username:password@hostname:5432/repairhub_db

# Secret key used to sign and verify JWT authentication tokens (min 32 chars)
JWT_SECRET=super_secret_jwt_random_string_replace_in_production_32chars

# Google Gemini API key for AI symptom diagnosis assistant (optional)
GEMINI_API_KEY=
